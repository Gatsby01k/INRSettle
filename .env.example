# Core app
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/inrsettle
# At least 32 random characters.
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# base64url value that decodes to 32 bytes; encrypts TOTP enrollment secrets.
# Generate independently from SESSION_SECRET and keep it in the secret manager.
MFA_ENCRYPTION_KEY=
# Independent base64url value that decodes to 32 bytes. Encrypts provider
# execution instructions and beneficiary data at rest.
SETTLEMENT_DATA_ENCRYPTION_KEY=
# Independent high-entropy value used to hash service API credentials.
API_KEY_PEPPER=
# At least 32 random characters. Authenticates the scheduled status-read retry worker.
CRON_SECRET=

# Manually maintained desk rate. There is no live FX feed; production quote
# creation fails closed when this is absent.
QUOTE_RATE_USDT_INR=83.50

# Optional controlled-pilot guardrails. Provider-observed commercial operations
# use organization and approval limits instead of these pilot caps.
CONTROLLED_PILOT_MAX_INR=1000
CONTROLLED_PILOT_DAILY_MAX_INR=2000
CONTROLLED_PILOT_ALLOWED_PROVIDERS=remitquickly,PontisGlobe

# RemitQuickly connector (server-only)
REMITQUICKLY_BASE_URL=
REMITQUICKLY_API_KEY=
REMITQUICKLY_API_SECRET=
REMITQUICKLY_WEBHOOK_SECRET=
REMITQUICKLY_DEFAULT_QUOTE_ID=
# REMITQUICKLY_WEBHOOK_URL=https://app.example.com/api/providers/remitquickly/webhook

# Pontis static-IP gateway values for the Next.js app. The Pontis API secrets
# below belong only on the whitelisted gateway host, not in Vercel/app env.
PONTIS_GATEWAY_URL=
PONTIS_GATEWAY_SECRET=
# Receives verified, re-signed callbacks from the Pontis gateway. Must match
# INRSETTLE_APP_WEBHOOK_SECRET on that gateway; do not reuse the request secret.
PONTIS_GATEWAY_WEBHOOK_SECRET=

# Pontis gateway-host values only
PONTIS_BASE_URL=
PONTIS_API_KEY=
PONTIS_ENCRYPTION_SECRET=
PONTIS_HMAC_SECRET=
PONTIS_EMAIL=
PONTIS_PASSWORD=

# ProviderConnection.credentialsRef accepts opaque references such as
# vault://inrsettle/tenant/provider. Connector credential strategy determines
# whether tenant-scoped or deployment-scoped secret resolution is used.

# One-time production bootstrap. Do not keep BOOTSTRAP_ADMIN_PASSWORD in the
# runtime environment after `npm run prisma:seed` succeeds.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORGANIZATION_ID=
BOOTSTRAP_ORGANIZATION_LEGAL_NAME=
BOOTSTRAP_ORGANIZATION_DISPLAY_NAME=
BOOTSTRAP_ORGANIZATION_COUNTRY=IN
BOOTSTRAP_RECONCILIATION_EMAIL=

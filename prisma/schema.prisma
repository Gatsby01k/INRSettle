generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  ADMIN
  TREASURY_MANAGER
  SETTLEMENT_OPERATOR
  COMPLIANCE_OFFICER
  FINANCE_VIEWER
}

enum QuoteStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  REJECTED
}

enum SettlementStatus {
  REQUESTED
  QUOTED
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  SETTLED
  RECONCILED
  FAILED
  CANCELLED
  ON_HOLD
}

enum Corridor {
  INR_USDT
  USDT_INR
}

enum ReconciliationStatus {
  OPEN
  MATCHED
  PARTIALLY_MATCHED
  UNMATCHED
  EXCEPTION
  RESOLVED
}

enum AuditActorType {
  USER
  API
  SYSTEM
}

enum ProofReceivedVia {
  WEBHOOK
  POLL
  MANUAL
}

enum ProviderConnectionStatus {
  DISABLED
  CONFIGURING
  INTEGRATION_VERIFIED
  COMMERCIAL_READY
  SUSPENDED
}

enum ProviderOperationType {
  FUNDING_REQUEST
  EXECUTION
  STATUS_CHECK
  REVERSAL
  RECONCILIATION
}

enum ProviderOperationStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
  REVIEW_REQUIRED
  RESOLVED_BY_STATUS
  RESOLVED_NO_EFFECT
}

enum ProviderWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum FundingStatus {
  NOT_REQUIRED
  REQUESTED
  ACKNOWLEDGED
  PARTIALLY_FUNDED
  FUNDED
  FAILED
  CANCELLED
}

enum DueDiligenceSubjectType {
  CLIENT
  PROVIDER
}

enum DueDiligenceStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
}

// Internal operating posture. Public and customer-facing workflows use the
// product labels Evidence-only, Provider-observed and Controlled pilot.
enum SettlementTestMode {
  EVIDENCE_ONLY
  PROVIDER_OBSERVED
  CONTROLLED_PILOT
}

model User {
  id                         String                           @id @default(cuid())
  email                      String                           @unique
  name                       String
  passwordHash               String
  mfaEnabled                 Boolean                          @default(false)
  mfaSecretCiphertext        String?
  mfaPendingSecretCiphertext String?
  mfaRecoveryCodeHashes      String[]                         @default([])
  mfaEnrolledAt              DateTime?
  authVersion                Int                              @default(0)
  failedLoginCount           Int                              @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  memberships                Membership[]
  auditLogs                  AuditLog[]
  quotes                     Quote[]                          @relation("QuoteCreator")
  settlements                Settlement[]                     @relation("SettlementCreator")
  dueDiligenceCreated        DueDiligenceCase[]               @relation("DueDiligenceCreator")
  dueDiligenceApproved       DueDiligenceCase[]               @relation("DueDiligenceApprover")
  apiCredentialsCreated      ApiCredential[]                  @relation("ApiCredentialCreator")
  settlementInstructions     SettlementExecutionInstruction[] @relation("SettlementInstructionCreator")

  @@index([email])
}

model Organization {
  id                     String                           @id @default(cuid())
  legalName              String
  displayName            String
  country                String                           @default("IN")
  status                 OrganizationStatus               @default(PENDING)
  baseCurrency           String                           @default("INR")
  settlementLimit        Decimal?                         @db.Decimal(20, 2)
  dailyLimit             Decimal?                         @db.Decimal(20, 2)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  memberships            Membership[]
  settings               OrganizationSettings?
  quotes                 Quote[]
  settlements            Settlement[]
  reconciliation         ReconciliationRecord[]
  auditLogs              AuditLog[]
  providerConnections    ProviderConnection[]
  providerOperations     ProviderOperation[]
  providerWebhookEvents  ProviderWebhookEvent[]
  dueDiligenceCases      DueDiligenceCase[]
  apiCredentials         ApiCredential[]
  apiIdempotencyRecords  ApiIdempotencyRecord[]
  settlementInstructions SettlementExecutionInstruction[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model OrganizationSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  approvalThreshold     Decimal      @default(2500000.00) @db.Decimal(20, 2)
  quoteTtlSeconds       Int          @default(900)
  webhookUrl            String?
  reconciliationEmail   String?
  requireMfaForApproval Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Quote {
  id               String       @id @default(cuid())
  organizationId   String
  createdById      String
  corridor         Corridor
  sourceCurrency   String
  targetCurrency   String
  sourceAmount     Decimal      @db.Decimal(20, 2)
  targetAmount     Decimal      @db.Decimal(20, 6)
  rate             Decimal      @db.Decimal(20, 8)
  feeBps           Int          @default(45)
  feeAmount        Decimal      @db.Decimal(20, 2)
  settlementWindow String       @default("same_day")
  status           QuoteStatus  @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        User         @relation("QuoteCreator", fields: [createdById], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement       Settlement?

  @@index([organizationId, status, createdAt])
}

model Settlement {
  id                    String                          @id @default(cuid())
  publicId              String                          @unique
  organizationId        String
  quoteId               String?                         @unique
  createdById           String
  reference             String
  corridor              Corridor
  sourceCurrency        String
  targetCurrency        String
  sourceAmount          Decimal                         @db.Decimal(20, 2)
  targetAmount          Decimal                         @db.Decimal(20, 6)
  feeAmount             Decimal                         @default(0) @db.Decimal(20, 2)
  status                SettlementStatus                @default(REQUESTED)
  testMode              SettlementTestMode              @default(PROVIDER_OBSERVED) @map("test_mode")
  fundingStatus         FundingStatus                   @default(NOT_REQUIRED)
  fundingRequired       Decimal?                        @db.Decimal(20, 6)
  fundedAmount          Decimal?                        @db.Decimal(20, 6)
  fundingCurrency       String?
  sourceAccount         String
  targetAccount         String
  provider              String?
  providerConnectionId  String?
  providerTransactionId String?
  providerStatus        String?
  providerResponse      Json?
  failureReason         String?
  approvedAt            DateTime?
  executedAt            DateTime?
  settledAt             DateTime?
  reconciledAt          DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  createdBy             User                            @relation("SettlementCreator", fields: [createdById], references: [id])
  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote                 Quote?                          @relation(fields: [quoteId], references: [id])
  events                SettlementEvent[]
  reconciliation        ReconciliationRecord[]
  providerProofs        ProviderProof[]
  providerConnection    ProviderConnection?             @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  providerOperations    ProviderOperation[]
  executionInstruction  SettlementExecutionInstruction?

  @@unique([organizationId, reference])
  @@unique([provider, providerTransactionId])
  @@index([organizationId, status, createdAt])
  @@index([providerTransactionId])
  @@index([providerConnectionId])
}

model SettlementExecutionInstruction {
  id                String       @id @default(cuid())
  organizationId    String
  settlementId      String       @unique
  payloadCiphertext String
  payloadVersion    Int          @default(1)
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement        Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  createdBy         User         @relation("SettlementInstructionCreator", fields: [createdById], references: [id])

  @@index([organizationId, updatedAt])
}

model ProviderConnection {
  id             String                   @id @default(cuid())
  organizationId String
  providerCode   String
  displayName    String
  status         ProviderConnectionStatus @default(CONFIGURING)
  credentialsRef String?
  configuration  Json?
  capabilities   Json?
  lastHealthAt   DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlements    Settlement[]
  operations     ProviderOperation[]
  webhookEvents  ProviderWebhookEvent[]

  @@unique([organizationId, providerCode])
  @@index([organizationId, status])
}

model DueDiligenceCase {
  id              String                  @id @default(cuid())
  organizationId  String
  subjectType     DueDiligenceSubjectType
  subjectRef      String
  legalName       String
  jurisdiction    String
  status          DueDiligenceStatus      @default(DRAFT)
  riskRating      RiskRating?
  evidenceSummary String
  createdById     String
  approvedById    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  nextReviewAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("DueDiligenceCreator", fields: [createdById], references: [id])
  approvedBy      User?                   @relation("DueDiligenceApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, subjectType, subjectRef])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, subjectType, legalName])
}

model ApiCredential {
  id                 String                 @id @default(cuid())
  organizationId     String
  name               String
  keyPrefix          String                 @unique
  secretHash         String
  role               Role                   @default(SETTLEMENT_OPERATOR)
  scopes             String[]               @default([])
  createdById        String
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime               @default(now())
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User                   @relation("ApiCredentialCreator", fields: [createdById], references: [id])
  idempotencyRecords ApiIdempotencyRecord[]

  @@index([organizationId, revokedAt, createdAt])
}

model ApiIdempotencyRecord {
  id              String        @id @default(cuid())
  organizationId  String
  apiCredentialId String
  key             String
  route           String
  requestHash     String
  responseStatus  Int?
  responseBody    Json?
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiCredential   ApiCredential @relation(fields: [apiCredentialId], references: [id], onDelete: Cascade)

  @@unique([apiCredentialId, route, key])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

model ProviderOperation {
  id                   String                  @id @default(cuid())
  organizationId       String
  settlementId         String?
  providerConnectionId String?
  providerCode         String
  operationType        ProviderOperationType
  status               ProviderOperationStatus @default(PENDING)
  idempotencyKey       String
  providerReference    String?
  requestSummary       Json?
  responseSummary      Json?
  errorCode            String?
  errorMessage         String?
  attemptCount         Int                     @default(0)
  lastAttemptAt        DateTime?
  nextRetryAt          DateTime?
  resolutionNote       String?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement           Settlement?             @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  providerConnection   ProviderConnection?     @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, providerCode, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, resolvedAt])
  @@index([settlementId, createdAt])
  @@index([providerCode, providerReference])
}

model ProviderWebhookEvent {
  id                   String                @id @default(cuid())
  organizationId       String?
  providerConnectionId String?
  providerCode         String
  eventKey             String
  signatureValid       Boolean
  status               ProviderWebhookStatus @default(RECEIVED)
  payloadHash          String
  payload              Json?
  errorMessage         String?
  receivedAt           DateTime              @default(now())
  processedAt          DateTime?
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  providerConnection   ProviderConnection?   @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)

  @@unique([providerCode, eventKey])
  @@index([organizationId, receivedAt])
  @@index([providerCode, status, receivedAt])
}

model SettlementEvent {
  id           String            @id @default(cuid())
  settlementId String
  fromStatus   SettlementStatus?
  toStatus     SettlementStatus
  note         String?
  actorId      String?
  createdAt    DateTime          @default(now())
  settlement   Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, createdAt])
}

model ReconciliationRecord {
  id              String               @id @default(cuid())
  organizationId  String
  settlementId    String?
  externalRef     String
  source          String
  amount          Decimal              @db.Decimal(20, 2)
  currency        String
  valueDate       DateTime
  status          ReconciliationStatus @default(OPEN)
  exceptionReason String?
  rawPayload      Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settlement      Settlement?          @relation(fields: [settlementId], references: [id])

  @@unique([organizationId, source, externalRef])
  @@index([organizationId, status, valueDate])
}

// Structured, append-only evidence of what a payout provider reported about a
// settlement. Provider status "completed" only means the payout MAY have
// completed; proof rows are one of the three independent inputs (proof +
// reconciliation + audit trail) that finality review requires before a
// settlement is safe to finalize. Multiple rows per settlement are expected
// (webhook + poll + manual sync) — never updated, never deleted.
model ProviderProof {
  id                    String           @id @default(cuid())
  settlementId          String
  provider              String
  providerTransactionId String?
  utr                   String?
  providerStatus        String
  actualAmount          Decimal?         @db.Decimal(20, 6)
  currency              String?
  rawResponse           Json?
  dedupeKey             String?          @unique
  receivedVia           ProofReceivedVia
  receivedAt            DateTime         @default(now())
  createdAt             DateTime         @default(now())
  settlement            Settlement       @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, receivedAt])
  @@index([provider, providerTransactionId])
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  userId         String?
  actorType      AuditActorType @default(USER)
  action         String
  resourceType   String
  resourceId     String?
  before         Json?
  after          Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
}
